#version 460 core

// ============================================================
// 全屏三角形的顶点着色器 —— 所有后处理 Pass 共用这一个
//
// ★ 不需要任何顶点数据（没有 VBO、没有 attribute）：
//   顶点位置直接用 gl_VertexID 算出来。
//   3 个顶点就覆盖整个屏幕（比全屏四边形少一个顶点、少一条对角线边界）。
//
//   顶点 0 → (0,0) → 裁剪空间 (-1,-1)   右下前
//   顶点 1 → (2,0) → 裁剪空间 ( 3,-1)   超出右边
//   顶点 2 → (0,2) → 裁剪空间 (-1, 3)   超出上边
//   → 三角形把 [-1,1]² 完全盖住；插值出来的 vUV 在屏幕内正好是 [0,1]
// ============================================================

out vec2 vUV;

void main()
{
    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
    vUV = p;                                  // 屏幕内的 UV ∈ [0,1]
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
